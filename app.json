{
  "expo": {
    "name": "HubliCab",
    "slug": "hublicab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-logo/hubliCab-logo.png",
    "scheme": "hublicab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app-logo/hubliCab-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hublicab.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-logo/hubliCab-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-logo/hubliCab-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}